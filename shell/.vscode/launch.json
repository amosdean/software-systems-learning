{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug shell",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/shell",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build shell"
            ,"setupCommands": [
                {
                    "description": "Follow child process after fork",
                    "text": "set follow-fork-mode child",
                    "ignoreFailures": false
                }
            ]
        }
    ]
}